{
  "name": "big-o-library",
  "private": true,
  "description": "Ferramentas de manutenção: recompilar o CSS do tema, rodar testes e checagens de qualidade. Para escrever conteúdo e ver o site basta o Hugo.",
  "scripts": {
    "build:css": "tailwindcss -i themes/big-o-library/assets/css/styles.css -o themes/big-o-library/assets/css/compiled/main.css --minify",
    "test": "node --test",
    "validar": "python3 scripts/validar.py",
    "lint:md": "markdownlint-cli2 --config .github/markdownlint.jsonc \"content/**/*.md\" \"*.md\" \".github/*.md\" \"#node_modules\"",
    "a11y": "node scripts/a11y.js",
    "check": "npm run validar && npm run lint:md && npm test && npm run build:css"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.4",
    "axe-core": "4.14.0",
    "markdownlint-cli2": "0.24.0",
    "puppeteer-core": "25.16.0",
    "tailwindcss": "4.3.4"
  },
  "engines": {
    "node": ">=20"
  }
}
